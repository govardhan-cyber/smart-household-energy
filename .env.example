# Firebase project credentials
# ─────────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your real Firebase project values below.
# 3. NEVER commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GEMINI_API_KEY=

# Web3Forms Access Key (100% free alternative to EmailJS with built-in autoresponder support)
VITE_WEB3FORMS_ACCESS_KEY=

# ImgBB API Key (free image hosting for client-side uploads)
VITE_IMGBB_API_KEY=

# EmailJS Configuration (used for user autoresponse confirmation email only)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=


